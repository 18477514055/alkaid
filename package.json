{
  "name": "alkaid",
  "version": "0.2.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "description": "瑶光 Alkaid —— 极简内核 + 插件化的个人 AI Agent 平台（本地优先，数据不出本机）",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "build": "vite build",
    "desktop": "electron .",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "gate": "node scripts/gate.mjs",
    "gate:release": "node scripts/gate.mjs --release"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.8",
    "koffi": "^3.3.6",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "license": "MIT",
  "author": "Alkaid contributors",
  "homepage": "https://github.com/18477514055/alkaid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/18477514055/alkaid.git"
  },
  "bugs": {
    "url": "https://github.com/18477514055/alkaid/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "local-first",
    "electron",
    "mcp",
    "sqlite",
    "typescript"
  ]
}
